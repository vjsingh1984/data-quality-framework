#!/usr/bin/env bash
# Pre-commit hook: runs black, ruff, and unit tests before allowing commits.
# Install with: git config core.hooksPath .githooks

set -e

echo "=== Pre-commit checks ==="

# 1. Black formatting check
echo "[1/3] Checking formatting (black)..."
if ! poetry run black --check dq/ 2>/dev/null; then
    echo "FAILED: black formatting check. Run 'poetry run black dq/' to fix."
    exit 1
fi
echo "  OK"

# 2. Ruff linting
echo "[2/3] Linting (ruff)..."
if ! poetry run ruff check dq/ 2>/dev/null; then
    echo "FAILED: ruff linting. Run 'poetry run ruff check --fix dq/' to auto-fix."
    exit 1
fi
echo "  OK"

# 3. Unit tests (no Spark required)
echo "[3/3] Running unit tests..."
if ! poetry run pytest -m "not spark" dq/tests/ -q --tb=line 2>/dev/null; then
    echo "FAILED: unit tests. Run 'poetry run pytest -m \"not spark\" dq/tests/ -v' for details."
    exit 1
fi
echo "  OK"

echo "=== All pre-commit checks passed ==="
